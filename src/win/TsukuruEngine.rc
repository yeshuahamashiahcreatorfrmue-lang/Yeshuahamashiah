// Windows version-info resource. Embeds legitimate metadata (product, company,
// description, version) into the .exe so it is not an "unknown, info-less"
// binary — this reduces heuristic AV/SmartScreen false positives. (A real cure
// for SmartScreen still requires a paid code-signing certificate.)
#include <windows.h>

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tsukuru Engine Project"
            VALUE "FileDescription",  "Tsukuru 2D RPG Game Engine"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TsukuruEngine"
            VALUE "OriginalFilename", "TsukuruEngine.exe"
            VALUE "ProductName",      "Tsukuru Engine"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Open-source RPG Maker-style engine"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
